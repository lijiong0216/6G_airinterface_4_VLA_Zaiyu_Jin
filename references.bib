	keywords = {Complexity theory, Computational modeling, Digital predistortion, Integrated circuit modeling, Mathematical model, Optimization, Predistortion, generalized memory polynomial, nonlinear distortion, optimization, power amplifier},
	pages = {7326--7340},
}


@article{han_joint_2024-1,
	title = {Joint {Resource} {Allocation} for {Time}-{Varying} {Underwater} {Acoustic} {Communication} {System}: {A} {Self}-{Reflection} {Adversarial} {Bandit} {Approach}},
	volume = {54},
	copyright = {https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html},
	issn = {2168-2216, 2168-2232},
	shorttitle = {Joint {Resource} {Allocation} for {Time}-{Varying} {Underwater} {Acoustic} {Communication} {System}},

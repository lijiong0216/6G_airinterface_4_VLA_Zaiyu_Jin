	keywords = {Detection algorithms, Detectors, Explainable deep learning, Iterative algorithms, MIMO communication, MIMO detection, Symbols, Training, Wireless communication, deep neural network, model-driven},
	pages = {9626--9639},
}

@article{liao_model-driven_2020,

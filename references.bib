	pages = {1--10},
}

@article{jiang_m4sc_2025,
	title = {{M4SC}: {An} {MLLM}-{Based} {Multi}-{Modal}, {Multi}-{Task} and {Multi}-{User} {Semantic} {Communication} {System}},

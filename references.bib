	keywords = {Antennas, Array signal processing, Hardware, MIMO communication, Millimeter wave systems, Nonlinear distortion, Radio frequency, energy efficiency, hybrid beamforming, power amplifier, spectral efficiency},
	pages = {7208--7221},
}

@article{fawzy_iterative_2023,

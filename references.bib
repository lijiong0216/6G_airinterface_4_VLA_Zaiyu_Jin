	title = {Auto-{Regressive} {Modeling} of the {Shadowing} for {RSS} {Mobile} {Tracking}},
	issn = {1938-1883},
	url = {https://ieeexplore.ieee.org/document/5962897/?arnumber=5962897},
	doi = {10.1109/icc.2011.5962897},
	abstract = {In this paper, we consider the tracking of mobile terminals based on the received signal strength (RSS) measured from several base stations. The spatial correlation of the random shadowing is exploited in order to improve the position tracking. We define an auto-regressive (AR) model of the temporal evolution of the shadowing. This model allows for performing a joint tracking of the position and the shadowing by applying a Rao- Blackwellized (RB) particle filter approximating the posterior probability distributions numerically. The simulation results show that the tracking can be improved by considering sufficiently high auto-regressive orders.},

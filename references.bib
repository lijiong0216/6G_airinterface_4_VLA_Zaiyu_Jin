@article{he_joint_2022,
	title = {Joint {User} {Scheduling} and {Beamforming} {Design} for {Multiuser} {MISO} {Downlink} {Systems}},
	issn = {1536-1276, 1558-2248},
	url = {https://ieeexplore.ieee.org/document/9930879/},
	doi = {10.1109/TWC.2022.3215666},
	abstract = {In multiuser communication systems, user scheduling and beamforming (US-BF) design are two fundamental problems that are usually studied separately in the existing literature. In this work, we focus on the joint US-BF design with the goal of maximizing the set cardinality of scheduled users, which is computationally challenging due to the non-convex objective function and the coupled constraints with discretecontinuous variables. To tackle these difﬁculties, a successive convex approximation based US-BF (SCA-USBF) optimization algorithm is ﬁrstly proposed. Then, inspired by wireless intelligent communication, a graph neural network based joint US-BF (J-USBF) learning algorithm is developed by combining the joint US and power allocation network model with the BF analytical solution. The effectiveness of SCA-USBF and J-USBF is veriﬁed by various numerical results, the latter achieves close performance and higher computational efﬁciency. Furthermore, the proposed J-USBF also enjoys the generalizability in dynamic wireless network scenarios.},
	language = {en},
	urldate = {2023-03-24},
	journal = {IEEE Transactions on Wireless Communications},
	author = {He, Shiwen and Yuan, Jun and An, Zhenyu and Huang, Wei and Huang, Yongming and Zhang, Yaoxue},
	year = {2022},
	pages = {1--1},
}

@inproceedings{liu_general_2022,
	address = {Rio de Janeiro, Brazil},
	title = {A {General} {Downlink} {Frequency}-domain {ICIC} {Framework} for {Next}-generation {RAN}},
	isbn = {978-1-66545-975-4},
	url = {https://ieeexplore.ieee.org/document/10008558/},
	doi = {10.1109/GCWkshps56602.2022.10008558},
	abstract = {Inter-cell interference (ICI) has been an inevitable problem and a key bottleneck for modern cellular networks, e.g., 4G and 5G. Although various inter-cell interference coordination (ICIC) solutions have been proposed in the literature, such as fractional frequency reuse (FFR) and varieties of methods based on graph theory (GT), many of them face some practical limitations, such as restricted network scenarios. In this paper, a novel GT-based downlink frequency-domain ICIC method is developed, which provides a uniﬁed approach to extending the traditional FFR to network scenarios of any type and shape meanwhile tackling the key challenges faced by existing GT-based ICIC methods. Furthermore, a general downlink frequencydomain ICIC framework based on the open radio access network (O-RAN) architecture is proposed and implemented, which can automatically adapt to dynamic network changes with the help of hierarchical intelligence. The experiment results based on the commercial-grade testbed show that the proposed ICIC method can signiﬁcantly improve the system throughput and spectrum efﬁciency, especially in the case of high trafﬁc load.},

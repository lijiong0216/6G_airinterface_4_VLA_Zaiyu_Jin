	keywords = {Action planning, Costs, Delays, Optimization, Search problems, Switches, Testing, Visualization, active sensing, conjugate prior, exponential family, hypothesis testing, multi-armed bandit, relative entropy, search problems, sequential analysis, switching cost},
	pages = {4790--4817},
}


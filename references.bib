	pages = {4094--4104},
}

@article{wu_beyond_2025,
	title = {Beyond {Radio}: {Het}-{Medium} {Networks} and {Its} {Cross}-{Medium} {Communication} {Paradigms} for {6G}},
	issn = {1558-156X},
	shorttitle = {Beyond {Radio}},
	url = {https://ieeexplore.ieee.org/document/10904469/},
	doi = {10.1109/MNET.2025.3546127},
	abstract = {In the evolving landscape of communication technologies, the integration of Heterogeneous Medium Networks (HetMNets) has emerged as a pivotal progression, signaling a departure from traditional, radio-centric paradigms. As we edge closer to the realization of 6G networks, understanding the intricate dynamics of cross-medium communication (CMC) becomes imperative. This article indicates the multifaceted nature of HetMNets and explores the transformative CMC paradigms shaping the roadmap toward 6G. First, we outline the key performance indicators (KPIs), potential scenarios, and the emerging technologies and applications of 6G wireless systems, which serve as the driving forces behind the development of HetMNets. Subsequently, various communication media are introduced, contrasting their propagation characteristics to underscore the indispensability of HetMNets for the 6G landscape. We then enumerate the general issues involving challenges/problems and potential technical solutions in HetMNets. Moreover, we present an air-sea coordinated CMC system model, serving as an example of HetMNets built upon CMC paradigms. Specifically, we tackle a power allocation challenge, optimizing the transmit power of both underwater acoustic and radio frequency (RF) communication media at the cross-medium bidirectional relay to curtail the outage probability. The corresponding solution highlights the efficacy of the proposed CMC paradigm in supporting the reliability and resource efficiency of HetMNets.},
	urldate = {2025-08-04},
	journal = {IEEE Network},
	author = {Wu, Mingming and Han, Yufeng and Xiao, Yue and Gao, Yulan and Li, Shiying and Niyato, Dusit and Karagiannidis, George K.},
	year = {2025},
	keywords = {6G, 6G mobile communication, Artificial intelligence, Biomedical optical imaging, Heterogeneous medium networks, Media, Optical sensors, Optical transmitters, Qubit, Radio frequency, Terahertz communications, Wireless communication, cross-medium communications},
	pages = {1--1},
}

@article{chergui_zero-touch_2021,

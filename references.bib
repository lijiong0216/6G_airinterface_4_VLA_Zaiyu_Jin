	keywords = {Adaptation models, Convergence, Costs, Data communication, Markov game, Optimization, Reinforcement learning, Reliability, Slice combination, multi-step temporal-difference, reinforcement learning},
	pages = {1128--1132},
}

@article{sciancalepore_onets_2022,
	title = {{ONETS}: {Online} {Network} {Slice} {Broker} {From} {Theory} to {Practice}},
	volume = {21},
	issn = {1558-2248},
	shorttitle = {{ONETS}},
	url = {https://ieeexplore.ieee.org/document/9495099/?arnumber=9495099},
	doi = {10.1109/TWC.2021.3094116},
	abstract = {Virtualization and network slicing offer an unprecedented opportunity to mobile network operators: open their physical network infrastructure platform to the concurrent deployment of multiple logical self-contained networks, namely network slices. In this paper, we propose and analyze ONETS, an Online NETwork Slicing solution that {\textbackslash}textbf i ) builds on the budgeted lock-up multi-armed bandit mathematical model and properties, {\textbackslash}textbf ii ) derives its analytical bounds in our proposed extension for network slicing, {\textbackslash}textbf iii ) seamlessly integrates into the 3GPP architecture, {\textbackslash}textbf iv ) proves its feasibility through a proof-of-concept implementation on commercial hardware considering three network slices and {\textbackslash}textbf v ) allows for the design of a low-complexity online network slice brokering solution that maximizes multiplexing gains.},

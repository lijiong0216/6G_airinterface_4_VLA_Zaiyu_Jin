	journal = {IEEE Wireless Communications},
	author = {Pan, Guangjin and Xu, Shugong and Jiang, Pin},
	year = {2024},
	note = {Conference Name: IEEE Wireless Communications},
	keywords = {Bandwidth, Delays, Low latency communication, Packet loss, Real-time systems, Throughput, Time factors},
	pages = {1--8},
}


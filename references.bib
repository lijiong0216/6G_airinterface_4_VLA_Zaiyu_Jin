	doi = {10.1109/LCOMM.2017.2701803},
	abstract = {Wireless network virtualization is identiﬁed as one of the key enabling technologies to bring ﬁfth-generation networks into fruition. In this letter, we model the service selection and resource purchasing problem as a two-stage combinatorial optimization problem. To solve this problem, we propose a hierarchical matching game-based scheme, which satisﬁes the efﬁcient resource allocation and strict isolation requirements. Simulation results show that our proposal outperforms the ﬁxed sharing approach by 32\% and achieves up to 97\% of performance obtained by the optimal approach (general sharing scheme) in terms of average sum rate.},

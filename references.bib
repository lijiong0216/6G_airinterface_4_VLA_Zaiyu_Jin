	keywords = {Bandwidth, Downlink, FDM, Frequency division multiplexing, Network slicing, Radio access networks, TDD, Throughput, Ultra reliable low latency communication, edge computing, latency, mmWave, new radio, numerology, slicing, spectral efficiency, throughput},
	pages = {1263--1274},
}


	keywords = {MIMO communication, MIMO-OFDM, MU-MIMO, Nonlinear distortion, Nonlinear power amplifiers, OFDM, Precoding, Transmitting antennas, large scale MIMO, linear precoding},
	pages = {6753--6765},
}

@article{you_massive_2022,
	title = {Massive {MIMO} {Hybrid} {Precoding} for {LEO} {Satellite} {Communications} {With} {Twin}-{Resolution} {Phase} {Shifters} and {Nonlinear} {Power} {Amplifiers}},
	volume = {70},

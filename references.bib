	month = jan,
	year = {2024},
	pages = {71--76},
}

@article{abood_lstm-based_2023,
	title = {An {LSTM}-{Based} {Network} {Slicing} {Classification} {Future} {Predictive} {Framework} for {Optimized} {Resource} {Allocation} in {C}-{V2X}},
	volume = {11},
	copyright = {https://creativecommons.org/licenses/by-nc-nd/4.0/},
	issn = {2169-3536},

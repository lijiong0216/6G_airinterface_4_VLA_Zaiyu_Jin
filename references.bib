	keywords = {Broadband communication, Channel models, Light emitting diodes, Linear systems, Nonlinear distortion, Optical distortion, Solid modeling, Visible light communication, nonlinearity modeling, optical wireless communication, visible light communication (VLC)},
	pages = {310--323},
}

@article{karbalaee_motalleb_resource_2023,
	title = {Resource {Allocation} in an {Open} {RAN} {System} {Using} {Network} {Slicing}},

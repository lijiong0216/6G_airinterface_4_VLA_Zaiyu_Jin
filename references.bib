@article{cui_survey_2012,
	title = {A {Survey} on {Delay}-{Aware} {Resource} {Control} for {Wireless} {Systems}—{Large} {Deviation} {Theory}, {Stochastic} {Lyapunov} {Drift}, and {Distributed} {Stochastic} {Learning}},

	note = {Conference Name: IEEE Transactions on Network and Service Management},
	keywords = {Cross-modal communications, Delays, Network slicing, Optimization, Quality of service, Reliability, Resource management, Streaming media, puncturing architecture, puncturing resource occupation modes, resource allocation},

@article{xia_quality_2025,
	title = {Quality of {Service}-{Driven} {Adaptive} {Deployment} {Optimization} {Strategy} for {Edge} {Intelligent} {Networks} in {Discrete} {Manufacturing} {Smart} {Factories}},

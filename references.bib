@misc{li_apple_2025,
	title = {Apple {Intelligence} {Foundation} {Language} {Models}: {Tech} {Report} 2025},
	shorttitle = {Apple {Intelligence} {Foundation} {Language} {Models}},
	url = {http://arxiv.org/abs/2507.13575},
	doi = {10.48550/arXiv.2507.13575},
	abstract = {We introduce two multilingual, multimodal foundation language models that power Apple Intelligence features across Apple devices and services: i a 3B-parameter on-device model optimized for Apple silicon through architectural innovations such as KV-cache sharing and 2-bit quantization-aware training; and ii a scalable server model built on a novel Parallel-Track Mixture-of-Experts PT-MoE transformer that combines track parallelism, mixture-of-experts sparse computation, and interleaved global-local attention to deliver high quality with competitive cost on Apple's Private Cloud Compute platform. Both models are trained on large-scale multilingual and multimodal datasets sourced via responsible web crawling, licensed corpora, and high-quality synthetic data, then further refined with supervised fine-tuning and reinforcement learning on a new asynchronous platform. The resulting models support several additional languages while understanding images and executing tool calls. In public benchmarks and human evaluations, both the server model and the on-device model match or surpass comparably sized open baselines. A new Swift-centric Foundation Models framework exposes guided generation, constrained tool calling, and LoRA adapter fine-tuning, allowing developers to integrate these capabilities with a few lines of code. The latest advancements in Apple Intelligence models are grounded in our Responsible AI approach with safeguards like content filtering and locale-specific evaluation, as well as our commitment to protecting our users' privacy with innovations like Private Cloud Compute.},
	urldate = {2025-11-12},
	publisher = {arXiv},
	author = {Li, Ethan and Larsen, Anders Boesen Lindbo and Zhang, Chen and Zhou, Xiyou and Qin, Jun and Yap, Dian Ang and Raghavan, Narendran and Chang, Xuankai and Bowler, Margit and Yildiz, Eray and Peebles, John and Coleman, Hannah Gillis and Ronchi, Matteo and Gray, Peter and You, Keen and Spalvieri-Kruse, Anthony and Pang, Ruoming and Li, Reed and Yang, Yuli and Soroush, Emad and Lu, Zhiyun and Xiao, Crystal and Situ, Rong and Huffaker, Jordan and Griffiths, David and Ahmed, Zaid and Zhang, Peng and Parilla, Daniel and Liberman, Asaf and Mallalieu, Jennifer and Mazaheri, Parsa and Chen, Qibin and Bilkhu, Manjot and Zhang, Aonan and Wang, Eric and Nelson, Dave and FitzMaurice, Michael and Voice, Thomas and Liu, Jeremy and Shaffer, Josh and Zhao, Shiwen and Yadla, Prasanth and Rasteh, Farzin and Guo, Pengsheng and Farooq, Arsalan and Snow, Jeremy and Murphy, Stephen and Lei, Tao and Cho, Minsik and Horrell, George and Dodge, Sam and Hislop, Lindsay and Singh, Sumeet and Dombrowski, Alex and Raghavan, Aiswarya and Sirovica, Sasha and Saebi, Mandana and Lao, Faye and Lam, Max and Lu, T. J. and Xu, Zhaoyang and Singh, Karanjeet and Kirchner, Marc and Mizrahi, David and Arora, Rajat and Zhang, Haotian and Mason, Henry and Zhou, Lawrence and Hua, Yi and Jain, Ankur and Bai, Felix and Astrauskas, Joseph and Weers, Floris and Gardner, Josh and Chiang, Mira and Zhang, Yi and Agrawal, Pulkit and Sun, Tony and Keunebroek, Quentin and Hopkins, Matthew and Wu, Bugu and Jia, Tao and Chen, Chen and Zhou, Xingyu and Wang, Nanzhu and Liu, Peng and Hou, Ruixuan and Rauch, Rene and Gao, Yuan and Dehghan, Afshin and Janke, Jonathan and Wang, Zirui and Chen, Cha and Ren, Xiaoyi and Nan, Feng and Elman, Josh and Yin, Dong and Goren, Yusuf and Lai, Jeff and Fei, Yiran and Evans, Syd and Yu, Muyang and Yin, Guoli and Qin, Yi and Feldman, Erin and Garg, Isha and Rajamani, Aparna and Vega, Karla and Cheng, Walker and Collins, T. J. and Han, Hans and Menacho, Raul Rea and Yeung, Simon and 
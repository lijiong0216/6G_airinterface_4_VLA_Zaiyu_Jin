	number = {7},
	urldate = {2024-04-08},
	journal = {Electronics},
	author = {Sun, Yanzan and Huang, Yanyu and Yu, Tao and Chen, Xiaojing and Zhang, Shunqing},
	month = mar,
	year = {2023},
	pages = {1563},
}


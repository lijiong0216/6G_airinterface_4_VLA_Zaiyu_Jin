}

@article{uwizeyimana_joint_2024,
	title = {Joint {User} {Association} and {Pairing} in {Multi}-{UAV}- {Assisted} {NOMA} {Networks}: {A} {Decaying}-{Epsilon} {Thompson} {Sampling} {Framework}},
	volume = {12},
	issn = {2169-3536},
	shorttitle = {Joint {User} {Association} and {Pairing} in {Multi}-{UAV}- {Assisted} {NOMA} {Networks}},
	url = {https://ieeexplore.ieee.org/document/10565893/?arnumber=10565893},
	doi = {10.1109/ACCESS.2024.3417320},
	abstract = {Unmanned aerial vehicles (UAVs) are expected to be integrated into future wireless networks to offer services, especially in unreachable or congested areas. To improve the spectral efficiency, non-orthogonal multiple access (NOMA) scheme can be utilised within the UAV communication to allow more users to be covered and associated. The performance of the NOMA-UAVs network is governed by several factors including power allocation, user association and pairing methods. This paper presents an approach that uses multi-armed bandit (MAB) and two-sided matching frameworks to maximize the throughput of multi-UAV-assisted NOMA networks in a decentralized manner. The approach enables the UAVs to propose to the ground users (GUs) without explicit cooperation among the UAVs while the GUs can accept or reject the proposals. To this end, we propose a modified Thompson sampling algorithm that we named decaying epsilon Thompson sampling ( {\textbackslash}text D{\textbackslash}epsilon {\textbackslash}text TS ) MAB algorithm that is designed to improve the exploration-exploitation tradeoff in the MAB. The performance of the proposed {\textbackslash}text D{\textbackslash}epsilon {\textbackslash}text TS MAB algorithm is evaluated against other existing MAB techniques. Simulation results show that the {\textbackslash}text D{\textbackslash}epsilon {\textbackslash}text TS algorithm attains faster convergence and improved performance in terms of smaller regret and increased achievable system throughput. The {\textbackslash}text D{\textbackslash}epsilon {\textbackslash}text TS MAB algorithm particularly excels in regards of the convergence rate when the number of available action spaces increases.},
	urldate = {2024-07-31},
	journal = {IEEE Access},
	author = {Uwizeyimana, Boniface and Abo-Zahhad, Mohammed and Muta, Osamu and Abd El-Malek, Ahmed H. and Elsabrouty, Maha M.},
	year = {2024},
	note = {Conference Name: IEEE Access},
	keywords = {Autonomous aerial vehicles, Multi-UAV networks, NOMA, Proposals, Quality of service, Resource management, Standards, Thompson sampling, Throughput, decaying-epsilon, multi-armed bandit, throughput maximization, two-sided matching, user association and pairing},
	pages = {87167--87180},
}

@inproceedings{lien_efficient_2017,
	title = {Efficient {Ultra}-{Reliable} and {Low} {Latency} {Communications} and {Massive} {Machine}-{Type} {Communications} in {5G} {New} {Radio}},
	url = {https://ieeexplore.ieee.org/document/8254211/?arnumber=8254211},
	doi = {10.1109/GLOCOM.2017.8254211},
	abstract = {Different from the International Mobile Telecommunications Advanced (IMT-Advanced) system solely enhancing the transmission data rates regardless the variety of emerging wireless traffic, the IMT-2020 system supports enhanced mobile broadband (eMBB), massive machine-type communications (mMTC) and ultra-reliable and low latency communications (URLCC) to fully capture diverse wireless services in 2020. To satisfactorily gratify the scope of IMT-2020, 3GPP has launched the standardization activity of the fifth generation (5G) New Radio (NR) to deploy the first phase (Release 15) system in 2018 and the ready (Release 16) system in 2020. As eMBB is a legacy system from IMT- Advanced, URLLC jointly demanding low latency and high reliability, and mMTC emphasizes on high reliability may consequently induce significant impacts on the designs of NR air interface. On the advert of the conventional feedback based transmission in LTE/LTE-A designed for eMBB imposing potential inefficiency in the support of URLLC and mMTC, in this paper, we revisit the feedbackless transmission framework, and reveal a tradeoff between these two transmission frameworks. A multi-armed bandit (MAB) based reinforcement learning approach is therefore proposed to achieve the optimum harmonization of feedback and feedbackless transmissions. Our simulation results fully demonstrate the practicability of the proposed approach in supporting URLLC and mMTC, to justify the potential of our approach in the design of 5G NR.},
	urldate = {2024-07-31},
	booktitle = {{GLOBECOM} 2017 - 2017 {IEEE} {Global} {Communications} {Conference}},
	author = {Lien, Shao-Yu and Hung, Shao-Chou and Deng, Der-Jiunn and Wang, Yueh Jir},
	month = dec,
	year = {2017},
	keywords = {5G mobile communication, Encoding, Mobile computing, Probability, Receivers, Reliability},
	pages = {1--7},
}


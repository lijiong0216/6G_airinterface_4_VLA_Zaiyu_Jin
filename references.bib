	note = {Conference Name: IEEE Transactions on Mobile Computing},
	keywords = {Compounds, Multi-armed bandit, Optimization, Program processors, Stochastic processes, Task analysis, Throughput, Transcoding, network application optimization, online learning, performance guarantee, stochastic rewards, time-varying rewards},
	pages = {5346--5358},
}


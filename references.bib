	keywords = {Array signal processing, Batteries, Climate change, CoMP systems, Global warming, Lyapunov optimization, Optimization, Resource management, Smart grids, Two-scale control, Wireless communication, ahead-of-time market, battery degeneration, real-time market, smart grids},

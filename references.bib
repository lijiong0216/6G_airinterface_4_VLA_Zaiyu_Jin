	note = {Conference Name: IEEE Transactions on Vehicular Technology},
	keywords = {3GPP, Antenna arrays, IEEE 802.11 Standard, Markov chains, Measurement, Millimeter wave communication, NR-U, New Radio, QoS, Quality of service, Resource management, offloading, overflow traffic, queuing theory},
	pages = {2535--2549},
}

@article{xu_millimeter-wave_2022,
	title = {Millimeter-{Wave} {NR}-{U} and {WiGig} {Coexistence}: {Joint} {User} {Grouping}, {Beam} {Coordination}, and {Power} {Control}},
	volume = {21},
	issn = {1558-2248},
	shorttitle = {Millimeter-{Wave} {NR}-{U} and {WiGig} {Coexistence}},
	url = {https://ieeexplore.ieee.org/document/9540794/?arnumber=9540794},
	doi = {10.1109/TWC.2021.3111707},
	abstract = {Millimeter wave (mmWave) communication is a promising New Radio in Unlicensed (NR-U) technology to meet with the ever-increasing data rate and connectivity requirements in future wireless networks. However, the development of NR-U networks should consider the coexistence with the incumbent Wireless Gigabit (WiGig) networks. In this paper, we introduce a novel multiple-input multiple-output non-orthogonal multiple access (MIMO-NOMA) based mmWave NR-U and WiGig coexistence network for uplink transmission. Our aim for the proposed coexistence network is to maximize the spectral efficiency while ensuring the strict NR-U delay requirement and the WiGig transmission performance in real time environments. A joint user grouping, hybrid beam coordination and power control strategy is proposed, which is formulated as a Lyapunov optimization based mixed-integer nonlinear programming (MINLP) with unit-modulus and nonconvex coupling constraints. Hence, we introduce a penalty dual decomposition (PDD) framework, which first transfers the formulated MINLP into a tractable augmented Lagrangian (AL) problem. Thereafter, we integrate both convex-concave procedure (CCCP) and inexact block coordinate update (BCU) methods to approximately decompose the AL problem into multiple nested convex subproblems, which can be iteratively solved under the PDD framework. Numerical results illustrate the performance improvement ability of the proposed strategy, as well as demonstrating the effectiveness to guarantee the NR-U traffic delay and WiGig network performance.},
	number = {4},
	urldate = {2024-12-03},
	journal = {IEEE Transactions on Wireless Communications},
	author = {Xu, Xiaoxia and Chen, Qimei and Jiang, Hao and Huang, Jun},
	month = apr,
	year = {2022},
	note = {Conference Name: IEEE Transactions on Wireless Communications},
	keywords = {Array signal processing, IEEE 802.11 Standard, Interference, NOMA, NR-U and WiGig coexistence, Power control, Uplink, Wireless communication, beam coordination, mmWave MIMO-NOMA, user grouping},
	pages = {2352--2367},
}


}

@inproceedings{hua_gan-based_2019,
	address = {Waikoloa, HI, USA},
	title = {{GAN}-{Based} {Deep} {Distributional} {Reinforcement} {Learning} for {Resource} {Management} in {Network} {Slicing}},
